#. module: oversight
#: model:mail.template,body_html:oversight.email_template_summary
msgid ""
"<tbody>\n"
"                <t t-set=\"domain_name_probe_fails\" t-value=\"object."
"oversight_get_data('domain_name_probe_fails')\"/>\n"
"                <t t-set=\"url_probe_fails\" t-value=\"object."
"oversight_get_data('url_probe_fails')\"/>\n"
"                <t t-set=\"domain_name_probe_errors\" t-value=\"object."
"oversight_get_data('domain_name_probe_errors')\"/>\n"
"                <t t-set=\"url_probe_errors\" t-value=\"object."
"oversight_get_data('url_probe_errors')\"/>\n"
"                <t t-set=\"domain_name_probe_warnings\" t-value=\"object."
"oversight_get_data('domain_name_probe_warnings')\"/>\n"
"                <t t-set=\"url_probe_warnings\" t-value=\"object."
"oversight_get_data('url_probe_warnings')\"/>\n"
"\n"
"                <!-- domain Names Probe Fails-->\n"
"                <t t-if=\"domain_name_probe_fails\">\n"
"                    <h1>Echec(s) de sonde de nom de domaine</h1>\n"
"                    <table style=\"width: 100%;\" cellspacing=\"1\" "
"cellpadding=\"1\" border=\"1\">\n"
"                        <thead>\n"
"                            <tr>\n"
"                                <th>Nom de domaine</th>\n"
"                                <th>Détail du message</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <tr t-foreach=\"domain_name_probe_fails\" t-"
"as=\"domain_name\">\n"
"                                <td><t t-out=\"domain_name.name\"/></td>\n"
"                                <td><t t-out=\"domain_name."
"registrar_probe_last_error_message\"/></td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"                <!-- URL Probe Fails-->\n"
"                <t t-if=\"url_probe_fails\">\n"
"                    <h1>Echec(s) de sonde d'URL HTTPS</h1>\n"
"                    <table style=\"width: 100%;\" cellspacing=\"1\" "
"cellpadding=\"1\" border=\"1\">\n"
"                        <thead>\n"
"                            <tr>\n"
"                                <th>Site Web</th>\n"
"                                <th>Détail du message</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <tr t-foreach=\"url_probe_fails\" t-as=\"url\">\n"
"                                <td>\n"
"                                    <a t-att-href=\"'https://' + url."
"name\">https://<t t-out=\"url.name\"/></a>\n"
"                                </td>\n"
"                                <td><t t-out=\"url."
"certificate_probe_last_error_message\"/></td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"                <!-- Domain Names Expiration Errors-->\n"
"                <t t-if=\"domain_name_probe_errors\">\n"
"                    <h1>Expiration(s) de noms de domaine</h1>\n"
"                    <table style=\"width: 100%;\" cellspacing=\"1\" "
"cellpadding=\"1\" border=\"1\">\n"
"                        <thead>\n"
"                            <tr>\n"
"                                <th>Nom de domaine</th>\n"
"                                <th>Jours Restants</th>\n"
"                                <th>Date d'expiration</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <tr t-foreach=\"domain_name_probe_errors\" t-"
"as=\"domain_name\">\n"
"                                <td><t t-out=\"domain_name.name\"/></td>\n"
"                                <td><t t-out=\"domain_name."
"registrar_day_before_expiration\"/></td>\n"
"                                <td><t t-out=\"domain_name."
"registrar_expire_datetime\"/></td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"                <!-- URL Certificates Expiration Errors-->\n"
"                <t t-if=\"url_probe_errors\">\n"
"                    <h1>Expiration(s) de certificat HTTPS d'URL</h1>\n"
"                    <table style=\"width: 100%;\" cellspacing=\"1\" "
"cellpadding=\"1\" border=\"1\">\n"
"                        <thead>\n"
"                            <tr>\n"
"                                <th>Site Web</th>\n"
"                                <th>Jours Restants</th>\n"
"                                <th>Date d'expiration</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <tr t-foreach=\"url_probe_errors\" t-"
"as=\"url\">\n"
"                                <td>\n"
"                                    <a t-att-href=\"'https://' + url."
"name\">https://<t t-out=\"url.name\"/></a>\n"
"                                </td>\n"
"                                <td><t t-out=\"url."
"certificate_day_before_expiration\"/></td>\n"
"                                <td><t t-out=\"url."
"certificate_expire_datetime\"/></td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"                <!-- Domain Names Expiration warnings-->\n"
"                <t t-if=\"domain_name_probe_warnings\">\n"
"                    <h1>Avertissement(s) d'expiration de noms de domaine</"
"h1>\n"
"                    <table style=\"width: 100%;\" cellspacing=\"1\" "
"cellpadding=\"1\" border=\"1\">\n"
"                        <thead>\n"
"                            <tr>\n"
"                                <th>Nom de domaine</th>\n"
"                                <th>Jours Restants</th>\n"
"                                <th>Date d'expiration</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <tr t-foreach=\"domain_name_probe_warnings\" t-"
"as=\"domain_name\">\n"
"                                <td><t t-out=\"domain_name.name\"/></td>\n"
"                                <td><t t-out=\"domain_name."
"registrar_day_before_expiration\"/></td>\n"
"                                <td><t t-out=\"domain_name."
"registrar_expire_datetime\"/></td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"                <!-- URL Certificates Expiration Warnings-->\n"
"                <t t-if=\"url_probe_warnings\">\n"
"                    <h1>Avertissement(s) d'expiration de certificat HTTPS "
"d'URL</h1>\n"
"                    <table style=\"width: 100%;\" cellspacing=\"1\" "
"cellpadding=\"1\" border=\"1\">\n"
"                        <thead>\n"
"                            <tr>\n"
"                                <th>Site Web</th>\n"
"                                <th>Jours Restants</th>\n"
"                                <th>Date d'expiration</th>\n"
"                            </tr>\n"
"                        </thead>\n"
"                        <tbody>\n"
"                            <tr t-foreach=\"url_probe_warnings\" t-"
"as=\"url\">\n"
"                                <td>\n"
"                                    <a t-att-href=\"'https://' + url."
"name\">https://<t t-out=\"url.name\"/></a>\n"
"                                </td>\n"
"                                <td><t t-out=\"url."
"certificate_expire_datetime\"/></td>\n"
"                            </tr>\n"
"                        </tbody>\n"
"                    </table>\n"
"                </t>\n"
"\n"
"            </tbody>\n"
"        "
msgstr ""

