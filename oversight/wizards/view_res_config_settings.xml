<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="priority" eval="500"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Oversight" string="Oversight" name="oversight" groups="oversight.group_manager">
                    <block title="Threshold Management" id="threshold_management">
                        <setting id="recurring_tasks_setting" help="Number of days below which there will be a warning regarding the registrar expiration date">
                            <field name="registrar_warning_threshold"/>
                        </setting>
                        <setting id="task_dependencies_setting" help="Number of days below which there will be a warning regarding the certificate expiration date">
                            <field name="certificate_warning_threshold"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_res_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'oversight', 'bin_size': False}</field>
    </record>
</odoo>
