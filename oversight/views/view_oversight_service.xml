<odoo>

    <record id="view_oversight_service_search" model="ir.ui.view">
    <field name="model">oversight.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
           </search>
        </field>
    </record>

     <record id="view_oversight_service_list" model="ir.ui.view">
        <field name="model">oversight.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_oversight_service" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">oversight.service</field>
        <field name="view_mode">list</field>
        <field name="path">oversight-service</field>
    </record>

</odoo>
