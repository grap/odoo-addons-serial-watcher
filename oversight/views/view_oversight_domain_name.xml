<odoo>

    <record id="view_oversight_domain_name_search" model="ir.ui.view">
    <field name="model">oversight.domain.name</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="registrar_expire_datetime"/>
                <filter string="Not Updated" name="filter_not_updated" domain="[('registrar_name','=', False)]"/>
           </search>
        </field>
    </record>

     <record id="view_oversight_domain_name_list" model="ir.ui.view">
        <field name="model">oversight.domain.name</field>
        <field name="arch" type="xml">
            <list default_order="registrar_probe_last_state, registrar_expire_datetime">
                <field name="name"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
                <field name="registrar_name" optional="show"/>
                <field name="registrar_expire_datetime" optional="hide"/>
                <field name="registrar_day_before_expiration" optional="show"  widget="badge"
                    invisible="registrar_expire_datetime == False"
                    decoration-success="registrar_probe_state == 'success'"
                    decoration-warning="registrar_probe_state == 'warning'"
                    decoration-danger="registrar_probe_state == 'error'"
                    />
                <field name="registrar_probe_last_state" optional="show" widget="badge"
                    decoration-muted="registrar_probe_last_state == '01_probe_undefined'"
                    decoration-danger="registrar_probe_last_state == '02_probe_failed'"
                    decoration-success="registrar_probe_last_state == '03_probe_ok'"
                  />
                <field name="url_qty" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_oversight_domain_name_form" model="ir.ui.view">
        <field name="model">oversight.domain.name</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Update Registrar Info" name="button_update_registrar_info" type="object" />
                </header>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name" readonly="id != False"/>
                        </group>
                        <group string="Registrar Information">
                            <field name="registrar_name" string="Name"/>
                            <field name="registrar_creation_datetime" string="Registar Date"/>
                            <field name="registrar_expire_datetime" string="Expiration Date"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="page_urls" string="URLs">
                            <group>
                                <field name="url_ids" nolabel="1">
                                    <list>
                                        <field name="name" widget="url"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page name="page_probe_registrar" string="Registrar Probe Check">
                            <group>
                                <field name="registrar_probe_last_state" string="Last State" />
                                <field name="registrar_probe_last_error_message" string="Last Error Message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

        <record id="action_oversight_domain_name_button_update_registrar_info" model="ir.actions.server">
            <field name="name">Update Registrar Info</field>
            <field name="model_id" ref="oversight.model_oversight_domain_name"/>
            <field name="groups_id" eval="[(4, ref('oversight.group_manager'))]"/>
            <field name="binding_model_id" ref="oversight.model_oversight_domain_name" />
            <field name="state">code</field>
            <field name="code">records.button_update_registrar_info()</field>
        </record>

    <record id="action_oversight_domain_name" model="ir.actions.act_window">
        <field name="name">Domain Names</field>
        <field name="res_model">oversight.domain.name</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oversight_domain_name"
        parent="menu_oversight_overview"
        action="action_oversight_domain_name"
        sequence="20"/>

</odoo>
