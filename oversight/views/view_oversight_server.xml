<odoo>

    <record id="view_oversight_server_search" model="ir.ui.view">
    <field name="model">oversight.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Is Ours" name="filter_is_ours" domain="[('is_ours','=', True)]"/>
                <filter string="With Ping problem" name="filter_with_ping_problems" domain="[('ping_state','!=', '03_ok')]"/>
                <filter string="Ours With Ping problem" name="filter_is_ours_with_ping_problems" domain="[('ping_state','!=', '03_ok'), ('is_ours','=', True)]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
           </search>
        </field>
    </record>

     <record id="view_oversight_server_list" model="ir.ui.view">
        <field name="model">oversight.server</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name"/>
                <field name="ip" optional="hide"/>
                <field name="technical_name" optional="hide"/>
                <field name="services" optional="hide"/>
                <field name="service_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="activity_ids" optional="hide" widget="list_activity"/>
                <field name="invoice_partner_id" optional="show"/>
                <field name="monthly_cost" sum="Total" optional="show"/>
                <field name="supplier_partner_id" optional="show"/>
                <field name="data_center" optional="show"/>
                <field name="server_identifier" optional="hide"/>
                <field name="server_model_name" optional="hide"/>

                <field name="url_qty" optional="show"/>
                <field name="is_ours" widget="boolean_toggle" optional="hide"/>

                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

     <record id="view_oversight_url_list_ping" model="ir.ui.view">
        <field name="model">oversight.server</field>
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <list default_order="is_ours desc, ping_state" create="False">
                <field name="name"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
                <field name="services" optional="hide"/>
                <field name="service_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="data_center" optional="show"/>
                <field name="server_identifier" optional="show"/>
                <field name="server_model_name" optional="hide"/>
                <field name="is_ours" column_invisible="1"/>
                <field name="ping_state" widget="badge"
                    decoration-info="ping_state == '01_unknown'"
                    decoration-danger="ping_state == '02_ko'"
                    decoration-success="ping_state == '03_ok'"/>
                <field name="ping_error_message" />
                <button string="Check Ping" name="button_probe_ping_check" type="object" />
                <field name="ping_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>


    <record id="view_oversight_server_form" model="ir.ui.view">
        <field name="model">oversight.server</field>
        <field name="arch" type="xml">
            <form>
                <header >
                    <button string="Check Ping" name="button_probe_ping_check" type="object" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button type="object" class="oe_stat_button" icon="fa-list" name="action_view_probe_result_ping" >
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="ping_qty" />
                                </span>
                                <span class="o_stat_text">Results</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group col="3">
                        <group string="General Information">
                            <field name="name" invisible="1"/>
                            <field name="ip" readonly="id != False"/>
                            <field name="technical_name"/>
                            <field name="services"/>
                            <field name="service_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                            <field name="is_ours" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Invoicing">
                            <field name="monthly_cost"/>
                            <field name="invoice_partner_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Supplier">
                            <field name="supplier_partner_id"/>
                            <field name="data_center"/>
                            <field name="server_identifier"/>
                            <field name="server_model_name"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="probe">
                            <group string="Ping">
                                <field name="ping_active" widget="boolean_toggle" string="Active Probe"/>
                                <field name="ping_state" string="Last State"
                                    widget="badge"
                                    decoration-info="ping_state == '01_unknown'"
                                    decoration-danger="ping_state == '02_ko'"
                                    decoration-success="ping_state == '03_ok'"/>
                                <field name="ping_error_message" string="Last Error message"
                                    invisible="ping_state == 'ok'"/>
                            </group>
                        </page>
                        <page name="page_urls" string="URLs">
                            <group>
                                <field name="url_ids" nolabel="1">
                                    <list />
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_oversight_server_button_probe_ping_check" model="ir.actions.server">
        <field name="name">Execute Ping</field>
        <field name="model_id" ref="oversight.model_oversight_server"/>
        <field name="groups_id" eval="[(4, ref('oversight.group_manager'))]"/>
        <field name="binding_model_id" ref="oversight.model_oversight_server" />
        <field name="state">code</field>
        <field name="code">records.button_probe_ping_check()</field>
    </record>

    <record id="action_oversight_server" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">oversight.server</field>
        <field name="view_mode">list,form</field>
        <field name="path">oversight-server</field>
    </record>

    <record id="action_oversight_server_ping" model="ir.actions.act_window">
        <field name="name">Server Pings</field>
        <field name="res_model">oversight.server</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_oversight_url_list_ping" />
        <field name="context">{'search_default_filter_is_ours_with_ping_problems':1}</field>
        <field name="path">oversight-url-ping</field>
    </record>

</odoo>
