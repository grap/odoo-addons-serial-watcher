<odoo>

    <record id="view_oversight_url_search" model="ir.ui.view">
    <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="server_id"/>
                <field name="service_id"/>
                <field name="partner_id"/>
                <filter string="With Certificate Problems" name="filter_with_certificate_problems" domain="[('certificate_probe_state','!=', 'success')]"/>
                <filter string="Archived" name="filter_inactive" domain="[('active', '=', False)]"/>
           </search>
        </field>
    </record>

     <record id="view_oversight_url_list" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name" widget="url"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
                <field name="server_id" optional="show"/>
                <field name="service_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="domain_name_id" optional="show"/>
            </list>
        </field>
    </record>


     <record id="view_oversight_url_list_certificate_expiration" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="priority">500</field>
        <field name="arch" type="xml">
            <list default_order="certificate_probe_last_state,certificate_expire_datetime" create="False">
                <field name="name" widget="url"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
                <field name="server_id" optional="show"/>
                <field name="service_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="certificate_ssl_tls_version" optional="hide"/>
                <field name="certificate_expire_datetime" optional="hide"/>

                <field name="certificate_day_before_expiration" optional="show"  widget="badge"
                    invisible="certificate_expire_datetime == False"
                    decoration-success="certificate_probe_state == 'success'"
                    decoration-warning="certificate_probe_state == 'warning'"
                    decoration-danger="certificate_probe_state == 'error'"
                />
                <field name="certificate_probe_state" optional="show" widget="badge"
                    decoration-muted="certificate_probe_state == 'probe_undefined'"
                    decoration-danger="certificate_probe_state in ('error', 'probe_failed')"
                    decoration-warning="certificate_probe_state == 'warning'"
                    decoration-success="certificate_probe_state == 'success'"
                />
                <field name="certificate_probe_last_state" optional="hide" widget="badge"
                    decoration-muted="certificate_probe_last_state == '01_probe_undefined'"
                    decoration-danger="certificate_probe_last_state == '02_probe_failed'"
                    decoration-success="certificate_probe_last_state == '03_probe_ok'"
                />
            </list>
        </field>
    </record>

    <record id="view_oversight_url_form" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Update Certificate information" name="button_update_certificate_information" type="object" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group string="General Information">
                            <field name="name" widget="url" readonly="id != False"/>
                            <field name="domain_name_id"/>
                            <field name="server_id"/>
                            <field name="service_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group string="Certificate SSL">
                            <field name="certificate_ssl_tls_version"/>
                            <field name="certificate_expire_datetime" string="Expiration Date"/>
                            <field name="certificate_warning_threshold" string="Warning Threshold"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="page_probe_certificate" string="Certificate Probe Check">
                            <group>
                                <field name="certificate_probe_last_state" string="Last State" />
                                <field name="certificate_probe_last_error_message" string="Last Error Message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_oversight_url_button_update_certificate_information" model="ir.actions.server">
        <field name="name">Update Certification Information</field>
        <field name="model_id" ref="oversight.model_oversight_url"/>
        <field name="groups_id" eval="[(4, ref('oversight.group_manager'))]"/>
        <field name="binding_model_id" ref="oversight.model_oversight_url" />
        <field name="state">code</field>
        <field name="code">records.button_update_certificate_information()</field>
    </record>

    <record id="action_oversight_url" model="ir.actions.act_window">
        <field name="name">URLs</field>
        <field name="res_model">oversight.url</field>
        <field name="view_mode">list,form</field>
        <field name="path">oversight-url</field>
    </record>

    <record id="action_oversight_url_certificate_expiration" model="ir.actions.act_window">
        <field name="name">SSH Certificate Expirations</field>
        <field name="res_model">oversight.url</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_oversight_url_list_certificate_expiration" />
        <field name="context">{'search_default_filter_with_certificate_problems':1}</field>
        <field name="path">oversight-url-certificate-expiration</field>
    </record>

</odoo>
