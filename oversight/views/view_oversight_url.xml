<odoo>

    <record id="view_oversight_url_search" model="ir.ui.view">
    <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Not Updated" name="filter_not_updated" domain="[('certificate_ssl_tls_version','=', False)]"/>

           </search>
        </field>
    </record>

     <record id="view_oversight_url_list" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <list default_order="certificate_expire_datetime">
                <field name="name" widget="url"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
                <field name="server_id" optional="hide"/>
                <field name="domain_name_id" optional="hide"/>
                <field name="certificate_ssl_tls_version" optional="hide"/>
                <field name="certificate_expire_datetime" optional="hide"/>

                <field name="certificate_day_before_expiration" optional="show"  widget="badge"
                    invisible="certificate_expire_datetime == False"
                    decoration-success="certificate_probe_state == 'success'"
                    decoration-warning="certificate_probe_state == 'warning'"
                    decoration-danger="certificate_probe_state == 'error'"
                    />
                <field name="certificate_probe_last_state" optional="show" widget="badge"
                    decoration-muted="certificate_probe_last_state == '01_probe_undefined'"
                    decoration-danger="certificate_probe_last_state == '02_probe_failed'"
                    decoration-success="certificate_probe_last_state == '03_probe_ok'"
                  />
            </list>
        </field>
    </record>

    <record id="view_oversight_url_form" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Update Cert info" name="button_update_cert_info" type="object" />
                </header>
                <sheet>
                    <group>
                        <group string="General Information">
                            <field name="name" widget="url" readonly="id != False"/>
                            <field name="domain_name_id"/>
                            <field name="server_id"/>
                        </group>
                        <group string="Certificate SSL">
                            <field name="certificate_ssl_tls_version"/>
                            <field name="certificate_expire_datetime"/>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_oversight_url_button_update_cert_info" model="ir.actions.server">
        <field name="name">Update Certification Info</field>
        <field name="model_id" ref="oversight.model_oversight_url"/>
        <field name="groups_id" eval="[(4, ref('oversight.group_manager'))]"/>
        <field name="binding_model_id" ref="oversight.model_oversight_url" />
        <field name="state">code</field>
        <field name="code">records.button_update_cert_info()</field>
    </record>


    <record id="action_oversight_url" model="ir.actions.act_window">
        <field name="name">URLs</field>
        <field name="res_model">oversight.url</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oversight_url"
        parent="menu_oversight_overview"
        action="action_oversight_url"
        sequence="10"/>

</odoo>
