<odoo>

    <record id="view_oversight_url_search" model="ir.ui.view">
    <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <search>
                <field name="url"/>
                <filter string="Not Updated" name="filter_not_updated" domain="[('ssl_tls_version','=', False)]"/>

           </search>
        </field>
    </record>

     <record id="view_oversight_url_list" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <list default_order="expire_datetime">
                <field name="url"/>
                <field name="server_id" optional="hide"/>
                <field name="domain_name_id" optional="hide"/>
                <field name="ssl_tls_version" optional="hide"/>
                <field name="day_before_expiration" optional="show" invisible="expire_datetime == False"
                    options="{'bg_color': 'orange: day_before_expiration &lt; 15 ; red: day_before_expiration &lt; 0'}"/>
                <field name="expire_datetime"/>

            </list>
        </field>
    </record>


    <record id="view_oversight_url_form" model="ir.ui.view">
        <field name="model">oversight.url</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Update Cert info" name="button_update_cert_info" type="object" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="url" widget="url"/>
                            <field name="domain_name_id"/>
                            <field name="server_id"/>
                            <field name="ssl_tls_version"/>
                            <field name="expire_datetime"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oversight_url_button_update_cert_info" model="ir.actions.server">
        <field name="name">Update Certification Info</field>
        <field name="model_id" ref="oversight.model_oversight_url"/>
        <field name="groups_id" eval="[(4, ref('oversight.group_manager'))]"/>
        <field name="binding_model_id" ref="oversight.model_oversight_url" />
        <field name="state">code</field>
        <field name="code">records.button_update_cert_info()</field>
    </record>


    <record id="action_oversight_url" model="ir.actions.act_window">
        <field name="name">URLs</field>
        <field name="res_model">oversight.url</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oversight_url"
        parent="menu_oversight_setting"
        action="action_oversight_url"
        sequence="20"/>

</odoo>
