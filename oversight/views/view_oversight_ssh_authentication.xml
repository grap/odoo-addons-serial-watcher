<odoo>

    <record id="view_oversight_ssh_authentication_search" model="ir.ui.view">
    <field name="model">oversight.ssh.authentication</field>
        <field name="arch" type="xml">
            <search>
                <field name="login"/>
           </search>
        </field>
    </record>

     <record id="view_oversight_ssh_authentication_list" model="ir.ui.view">
        <field name="model">oversight.ssh.authentication</field>
        <field name="arch" type="xml">
            <list>
                <field name="login"/>
                <field name="activity_ids" optional="show" widget="list_activity"/>
            </list>
        </field>
    </record>


    <record id="view_oversight_ssh_authentication_form" model="ir.ui.view">
        <field name="model">oversight.ssh.authentication</field>
        <field name="arch" type="xml">
            <form>
                <header/>
                <sheet>
                    <group>
                        <group>
                            <field name="login"/>
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_oversight_ssh_authentication" model="ir.actions.act_window">
        <field name="name">URLs</field>
        <field name="res_model">oversight.ssh.authentication</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_oversight_ssh_authentication"
        parent="menu_oversight_setting"
        action="action_oversight_ssh_authentication"
        sequence="30"/>

</odoo>
