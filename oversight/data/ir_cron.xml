<odoo noupdate="1">

    <record model="ir.cron" id="cron_oversight_domain_name_update_registrar_info">
        <field name="name">Oversight Domain Names: Update Registrar Information</field>
        <field name="model_id" ref="model_oversight_domain_name" />
        <field name="state">code</field>
        <field name="code">model.cron_update_registrar_information()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record model="ir.cron" id="cron_oversight_url_update_cert_info">
        <field name="name">Oversight URLs: Update Certification Information</field>
        <field name="model_id" ref="model_oversight_url" />
        <field name="state">code</field>
        <field name="code">model.cron_update_certificate_information()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <record model="ir.cron" id="cron_oversight_server_ping">
        <field name="name">Oversight Servers: Ping</field>
        <field name="model_id" ref="model_oversight_server" />
        <field name="state">code</field>
        <field name="code">model.cron_probe_ping_check()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
    </record>

    <record model="ir.cron" id="cron_oversight_send_mail">
        <field name="name">Oversight : Send Summary email</field>
        <field name="model_id" ref="model_res_config_settings" />
        <field name="state">code</field>
        <field name="code">model.cron_oversight_send_summary_email()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

</odoo>
