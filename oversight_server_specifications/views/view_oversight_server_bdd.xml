<odoo>

    <!-- FORM -->
    <record id="view_oversight_server_bdd_form" model="ir.ui.view">
        <field name="model">oversight.server.bdd</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="version"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_oversight_server_bdd_list" model="ir.ui.view">
        <field name="model">oversight.server.bdd</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="name"/>
                <field name="version"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

</odoo>
